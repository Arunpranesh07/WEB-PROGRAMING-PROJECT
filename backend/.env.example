# Environment Configuration for Smart Community Water Management Platform
APP_NAME="AquaFlow - Smart Community Water Platform"
ENV=development
DEBUG=True
API_V1_STR=/api

# Database connection
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/water_management
# SQLite fallback is automatic if postgres is unavailable or not configured
DATABASE_URL=sqlite:///./water_management.db

# JWT Security
SECRET_KEY=aquaflow-super-secret-development-key-32charsmin!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IoT API Security
SENSOR_API_KEY=aquaflow-sensor-secret-key-2026

# Storage
UPLOAD_DIR=./uploads/complaints
